# Puerto donde escucha ms-viajes
PORT=3011
# 127.0.0.1 = solo acepta conexiones desde el mismo equipo (el gateway Apache estará en ese mismo equipo)
HOST=127.0.0.1

# Conexión a MySQL (base de datos propia de ms-viajes)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=viajes_db
DB_USER=viajes_user
DB_PASSWORD=cambie-esta-clave

# Clave con la que se verifican los tokens JWT (la misma que usa ms-usuarios)
JWT_SECRET=cambie-esta-frase